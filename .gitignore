# Rust
.stkr-cargo-*.lock
.stkr-cargo-*.json
.stkr-cargo-*.pending
/target/
**/*.rs.bk

# Runtime outputs from dev stacks, exercises, and e2e runs
/.run/
.env

# Python
/.cache/
/.venv/
/tools/python/.venv/
/dist/
__pycache__/
*.py[cod]
*.so
*.pyd
*.pdb
.pytest_cache/
.coverage
.ruff_cache/
.mypy_cache/
.pyright/

# Documentation build outputs

# Web and Tauri
/node_modules/
/crates/dokime-gui/node_modules/
/crates/dokime-gui/dist/
/crates/dokime-gui/dist-report/
/crates/dokime-gui/.run/
/crates/dokime-gui/test-results/
/crates/dokime-gui/playwright-report/
/crates/dokime-gui/src-tauri/gen/

/crates/dokime-gui/src-tauri/binaries/*
!/crates/dokime-gui/src-tauri/binaries/.gitkeep
# Retired installer staging path may still exist in developer checkouts.
/crates/dokime-gui/src-tauri/resources/runtime/
/crates/dokime-gui/src-tauri/target/
/examples/*/dist/

# Local editor and OS noise
.DS_Store
Thumbs.db
.env
.env.local
.env.*.local
.mise.local.toml

# Local AI and agent metadata
.claude/settings.local.json
.playwright-mcp/

# Local validation artifacts
/.tmp/
/reports/
/execution-tablet-controls.png
/report-evidence-view.png
/report-summary-view.png
/report-timeline-view.png

# Local git worktrees container
.worktrees/

# Ralph Wiggum loop state (session-local; must survive `git clean -fd` recovery)
.claude/ralph-loop.local.md

# Default local output root for `dokime-cli serve`
/dokime-data/

# Key material never belongs in the repository; tests generate throwaway identities.
*.pem
*.key

# Plugin bundles are build outputs of the plugin build system, never sources.
# They are tens of megabytes each and must never enter history; `mise run
# check` refuses a tracked one.
*.dokime

# Private Agent Artifacts
/.stkr/state/
/.stkr/task/
/.stkr/specifications/

# Hub Machine State
/.stkr/generated/

# Core dumps left by an aborted WebView under the e2e gate.
/core
/core.*

# Generated report embedded by the runtime and included in source distributions.
/crates/dokime-runtime/dist-report/

# Retired Private Namespace Must Never Enter History
/.stkr/agents/

# Hub Machine State
/.stkr/tests/
/.stkr/benchmarks/

# BEGIN Stkr CI
/.cache/
# END Stkr CI

# OpenSpec Changes And Specs Are Tracked; Uncomment To Keep Them Local.
# /openspec/
