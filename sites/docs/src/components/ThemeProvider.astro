import ThemeProvider from "@astrojs/starlight/components/ThemeProvider.astro";
---

<ThemeProvider />
<script is:inline>
  // Starlight Owns the Mode; the Shared Product Styles Read the Dark Class.
  (() => {
    const root = document.documentElement;
    const syncProductTheme = () => root.classList.toggle("dark", root.dataset.theme === "dark");
    syncProductTheme();
    new MutationObserver(syncProductTheme).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
  })();
</script>
