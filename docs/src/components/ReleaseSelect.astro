---
// Dokime — SPDX-License-Identifier: Apache-2.0
// Offer the Site's Entries From Its Root versions.json; Without It, Show Only the Current Entry.
import Select from "@astrojs/starlight/components/Select.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const entry = base.split("/").filter(Boolean).at(-1) ?? "dev";
const root = base.slice(0, base.length - entry.length - 1);
---

<dokime-release-select data-entry={entry} data-root={root}>
  <Select
    icon="code-branch"
    label="Release"
    width="10em"
    options={[
      {
        value: entry,
        label: entry === "dev" ? "Development" : entry,
        selected: true,
      },
    ]}
  />
</dokime-release-select>
<ThemeSelect />

<script>
  for (const host of document.querySelectorAll<HTMLElement>(
    "dokime-release-select",
  )) {
    const select = host.querySelector("select");
    const entry = host.dataset.entry ?? "";
    const root = host.dataset.root ?? "/";
    if (!select) continue;
    fetch(`${root}versions.json`)
      .then((response) => (response.ok ? response.json() : []))
      .then((entries: { entry: string; label: string }[]) => {
        if (!Array.isArray(entries) || entries.length === 0) return;
        select.replaceChildren(
          ...entries.map(
            (item) =>
              new Option(item.label, item.entry, false, item.entry === entry),
          ),
        );
      })
      .catch(() => undefined);
    select.addEventListener("change", () => {
      const page = location.pathname.startsWith(`${root}${entry}/`)
        ? location.pathname.slice(`${root}${entry}/`.length)
        : "";
      location.assign(`${root}${select.value}/${page}`);
    });
  }
</script>
