{
  "include": [
    "packages/dokime/src/dokime",
    "packages/dokime/tests",
    "packages/dokime/examples"
  ],
  "typeCheckingMode": "standard",
  "pythonVersion": "3.13",
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingImports": "warning",
  "reportAttributeAccessIssue": "warning",
  "executionEnvironments": [
    {
      "root": "packages/dokime/src",
      "extraPaths": [
        "packages/dokime/src"
      ]
    },
    {
      "root": "packages/dokime/tests",
      "extraPaths": [
        "packages/dokime/src"
      ]
    },
    {
      "root": "packages/dokime/examples",
      "extraPaths": [
        "packages/dokime/src"
      ]
    }
  ],
  "exclude": [
    "packages/dokime/src/dokime/client/_generated"
  ]
}
