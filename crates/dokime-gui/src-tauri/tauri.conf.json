{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "create": false,
        "dragDropEnabled": true,
        "height": 960,
        "maximized": true,
        "minHeight": 720,
        "minWidth": 1080,
        "resizable": true,
        "title": "Dokime",
        "width": 1440
      }
    ]
  },
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [],
    "resources": [],
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "identifier": "com.stokker.dokime",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "dokime-test-hub"
        ]
      }
    },
    "gitlab": {
      "host": "https://gitlab.com",
      "oauthClientId": "",
      "projectId": "83808544",
      "redirectUri": "dokime-test-hub://auth/gitlab/callback"
    },
    "updater": {
      "endpoints": [
        "https://github.com/stokker-technologies/dokime/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1M0IzREQzMjg1MjExOUQKUldTZEVWSW8wejA3eFpFQVpuSXJnWFRHK1VEWjdmdTZTUVQ0ODBjejBnWHdwQk9lNVNxbHBRYnYK"
    }
  },
  "productName": "Dokime",
  "version": "0.1.0"
}
