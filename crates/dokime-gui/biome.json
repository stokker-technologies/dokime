{
  "extends": ["../../biome.json"],
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": true
    }
  },
  "files": {
    "includes": [
      "**/*.css",
      "**/*.json",
      "**/*.ts",
      "**/*.svelte",
      "!src/lib/rpc/generated",
      "!src/generated/organization",
      "!!**/.stkr/templates",
      "!!**/.*",
      "!src-tauri/**/*.json"
    ]
  },
  "vcs": {
    "root": "../.."
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "a11y": {
            "noHeaderScope": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/FailureConsequences.svelte"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/MediaGalleryCard.svelte", "src/components/MediaGalleryView.svelte"],
      "linter": {
        "rules": {
          "a11y": {
            "useMediaCaption": "off"
          }
        }
      }
    },
    {
      "includes": ["src/features/cycle/CycleSidebarCasesView.svelte"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementToInteractiveRole": "off",
            "useSemanticElements": "off"
          }
        }
      }
    }
  ]
}
