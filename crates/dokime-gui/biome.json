{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.mjs",
      "**/*.css",
      "**/*.json",
      "**/*.ts",
      "**/*.tsx",
      "!src/routeTree.gen.ts",
      "!src/lib/rpc/generated",
      "!src/generated/organization",
      "!src-tauri",
      "!!**/.stkr/templates",
      "!!**/.stkr/templates/**",
      "!!**/.*/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
