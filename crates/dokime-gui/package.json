{
  "name": "@dokime/gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "mise run bindings:generate && pnpm run typecheck && pnpm run build:live && pnpm run build:report && pnpm run check:assets",
    "build:live": "uv run --no-sync python -m dokime_tools.frontend live",
    "build:report": "node ./node_modules/vite/bin/vite.js build --config vite.report.config.ts",
    "build:report:watch": "uv run --no-sync python -m dokime_tools.desktop watch-report",
    "check": "biome ci . && pnpm run typecheck",
    "check:assets": "uv run --no-sync python -m dokime_tools.frontend assets",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "test": "pnpm run test:scripts",
    "test:scripts": "node --test src-tauri/tests/rpc/fixtures/generator.test.mjs",
    "test:e2e": "node e2e/native-desktop.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "uv run --no-sync python -m dokime_tools.desktop",
    "tauri:build": "node ./node_modules/@tauri-apps/cli/tauri.js build --config ../../branding/generated/tauri.brand.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@tauri-apps/api": "^2.11.1",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "lucide-react": "^0.561.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@bufbuild/protoc-gen-es": "2.12.1",
    "@tanstack/router-plugin": "^1.168.40",
    "@tauri-apps/cli": "^2.11.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
