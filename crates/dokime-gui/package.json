{
  "name": "@dokime/gui",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "pnpm run build:live && pnpm run build:report",
    "build:live": "uv run --no-sync python -m dokime_tools.build.frontend live",
    "build:report": "uv run --no-sync python -m dokime_tools.build.frontend report",
    "build:report:watch": "uv run --no-sync python -m dokime_tools.build.desktop watch-report",
    "check": "biome ci . && pnpm run typecheck",
    "check:assets": "uv run --no-sync python -m dokime_tools.build.frontend assets",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "node e2e/native-desktop.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "uv run --no-sync python -m dokime_tools.build.desktop"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@tauri-apps/api": "^2.12.3",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-contour": "^4.0.2",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "lucide-react": "^1.55.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@tanstack/router-generator": "1.167.46",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  }
}
