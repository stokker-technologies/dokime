[package]
name = "{{package}}"
publish = false
version = "0.1.0"
edition = "2024"
rust-version = "1.99"
description = "A native Dokime plugin driving a simulated thermal bench"
license = "Apache-2.0"

[features]
default = ["runtime"]
# Generated operation resource wiring is gated on this crate's `runtime` feature.
runtime = []

[dependencies]
tracing = "0.1"
dokime = { git = "{{repository}}", tag = "v{{sdk_version}}", features = ["plugin-sidecar"] }
plugin-host = { git = "{{repository}}", tag = "v{{sdk_version}}", default-features = false }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
thiserror = "2"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "sync", "time"] }
