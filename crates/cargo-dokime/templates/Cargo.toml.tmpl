[package]
name = "{{package}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.99"
description = "A native Dokime plugin driving a simulated thermal bench"
license = "Apache-2.0"

[dependencies]
tracing = "0.1"
dokime = { git = "{{repository}}", branch = "dev", features = ["plugin-sidecar"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
thiserror = "2"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "sync", "time"] }

[profile.dev]
debug = "line-tables-only"
split-debuginfo = "unpacked"

[profile.dev.package."*"]
opt-level = 2

[profile.release]
lto = "thin"
codegen-units = 1
strip = "symbols"

[profile.release-tests]
inherits = "release"
lto = false
codegen-units = 16
incremental = false

[profile.bench]
inherits = "release"
lto = false
incremental = false
debug = "line-tables-only"
strip = "none"
