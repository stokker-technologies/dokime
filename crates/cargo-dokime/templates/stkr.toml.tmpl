# Project Policy Owned By The Hub
# Native manifests own package metadata; mise owns executable recipes.
# Defaults stay implicit. Commented sections do not declare configuration.

# === Project === #

[project]
name = "{{package}}"
profile = "plugin"
visibility = "public"
platforms = ["linux", "windows"]

[languages.rust]
roots = ["src", "tests"]

[languages.python]
roots = ["tools/python"]

