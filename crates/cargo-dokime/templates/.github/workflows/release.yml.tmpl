# Rendered-pending: the plugin-profile output of `stkr project update` from templates/ci/.github/workflows/release.yml
# (Hub refactor/test-layers), copied by hand until the Hub renders it; the gate and the release verify
# through `mise run test:verify` and `mise run ci` instead of the internal evidence tooling.
name: Release
"on":
  push:
    tags:
    - v*
permissions:
  contents: read
env:
  MISE_LOCKED: "1"
  MISE_DATA_DIR: ${{ github.workspace }}/.cache/mise
  CARGO_TERM_COLOR: always
jobs:
  package:
    name: Package / Release
    runs-on:
    - ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      actions: read
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        fetch-depth: 0
    - uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
      id: tools
      with:
        path: .cache/mise/
        key: ${{ runner.os }}-${{ runner.arch }}-mise-${{ hashFiles('mise.lock') }}
    - uses: jdx/mise-action@08ae2a091c038e1e05ec6f5115dc5c69d5a2a6b8
      with:
        install: true
        cache: false
        mise_dir: ${{ github.workspace }}/.cache/mise
    - run: mise run ci
    - run: mise run package:rust --profile release
    - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
      if: always()
      with:
        name: package-${{ github.sha }}
        path: dist/
        if-no-files-found: ignore
        retention-days: 7
        include-hidden-files: true
  release_publish:
    name: Release / Publish
    needs:
    - package
    environment: Publish
    runs-on:
    - ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: write
      id-token: write
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        fetch-depth: 0
    - uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
      id: tools
      with:
        path: .cache/mise/
        key: ${{ runner.os }}-${{ runner.arch }}-mise-${{ hashFiles('mise.lock') }}
    - uses: jdx/mise-action@08ae2a091c038e1e05ec6f5115dc5c69d5a2a6b8
      with:
        install: true
        cache: false
        mise_dir: ${{ github.workspace }}/.cache/mise
    - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333
      with:
        name: package-${{ github.sha }}
        path: dist/
    - id: crates
      uses: rust-lang/crates-io-auth-action@v1
    - run: mise run release:publish
      env:
        CARGO_REGISTRY_TOKEN: ${{ steps.crates.outputs.token }}
        GH_TOKEN: ${{ github.token }}
