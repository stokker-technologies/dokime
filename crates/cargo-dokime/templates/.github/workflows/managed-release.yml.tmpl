    name: Publish
    runs-on: ${{ fromJSON(inputs.runners).linux.small }}
    timeout-minutes: 30
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        fetch-depth: 0
