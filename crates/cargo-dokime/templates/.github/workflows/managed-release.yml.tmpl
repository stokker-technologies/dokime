name: Release
"on":
  workflow_call:
    inputs:
      runners:
        type: string
        required: true
      ready:
        type: boolean
        required: true
        description: Every job of the calling graph succeeded or was skipped
      review_run:
        type: string
        default: ""
      review_profile:
        type: string
        default: ""
      review_sha:
        type: string
        default: ""
      review_version:
        type: string
        default: ""
      bump:
        type: string
        default: auto
        description: auto, minor or major; Release / Prepare only
    secrets:
      release_token:
        required: false
      CRATES_BOOTSTRAP_TOKEN:
        required: false
      mirror_deploy_key:
        required: false
      mirror_ssh_url:
        required: false
      runner_group_read_token:
        required: false
permissions:
  contents: read
env:
  PROFILE: >-
    ${{ inputs.review_profile != '' && inputs.review_profile ||
    (startsWith(github.ref, 'refs/tags/v') && 'release' || 'dev') }}
  MISE_LOCKED: "1"
  CARGO_INCREMENTAL: "0"
  CARGO_HOME: ${{ github.workspace }}/.cache/cargo
  npm_config_store_dir: ${{ github.workspace }}/.cache/pnpm
  UV_CACHE_DIR: ${{ github.workspace }}/.cache/uv
  RELEASE_BUILD_RUN_ID: ${{ inputs.review_run != '' && inputs.review_run || github.run_id }}
  RELEASE_BUILD_SHA: ${{ inputs.review_sha != '' && inputs.review_sha || github.sha }}
  RELEASE_BUILD_VERSION: ${{ inputs.review_version }}
jobs:
