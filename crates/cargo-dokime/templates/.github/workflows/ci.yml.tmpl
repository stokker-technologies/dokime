    env:
      MISE_ENABLE_TOOLS: >-
        go,python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,aqua:koalaman/shellcheck,go:github.com/rhysd/actionlint/cmd/actionlint,git-cliff
    if: >-
      (true) && (github.event_name != 'pull_request' || (github.event.action !=
      'closed' && !github.event.pull_request.draft))
    concurrency:
      group: >-
        ci-${{ github.workflow }}-check_python-shared-${{ github.event_name ==
        'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
        github.run_id }}
      cancel-in-progress: ${{ github.event_name == 'pull_request' }}
