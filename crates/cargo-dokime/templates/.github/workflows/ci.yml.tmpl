        CACHE_RESTORES: "{\"Mise\":\"${{ steps.setup_windows.outputs.mise-cache-hit == 'true' && 'Exact Hit' || steps.setup_windows.outputs.mise-cache-hit == 'false' && 'Partial Hit' || steps.setup_windows.outputs.mise-outcome == 'success' && 'Miss' || 'Unavailable' }}\",\"Cargo\":\"${{ steps.setup_windows.outputs.cargo_downloads-cache-hit == 'true' && 'Exact Hit' || steps.setup_windows.outputs.cargo_downloads-cache-hit == 'false' && 'Partial Hit' || steps.setup_windows.outputs.cargo_downloads-outcome == 'success' && 'Miss' || 'Unavailable' }}\",\"UV\":\"${{ steps.setup_windows.outputs.uv-cache-hit == 'true' && 'Exact Hit' || steps.setup_windows.outputs.uv-cache-hit == 'false' && 'Partial Hit' || steps.setup_windows.outputs.uv-outcome == 'success' && 'Miss' || 'Unavailable' }}\"}"
      uses: ./.github/actions/save-caches
      with:
        summary-module: ""
    env:
      MISE_ENABLE_TOOLS: >-
        go,python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,aqua:koalaman/shellcheck,go:github.com/rhysd/actionlint/cmd/actionlint,git-cliff
    strategy:
      fail-fast: false
      matrix:
        platform:
        - unix
        - windows
        include:
        - platform: unix
          runner: ubuntu-latest
          minutes: 120
          container: ""
        - platform: windows
          runner: windows-latest
          minutes: 120
          container: ""
    if: >-
      (true) && (github.event_name != 'pull_request' || (github.event.action !=
      'closed' && !github.event.pull_request.draft))
    concurrency:
      group: >-
        ci-${{ github.workflow }}-validate_test_rust_unit-${{ matrix.platform }}-${{
        github.event_name == 'pull_request' && github.event.number || github.event_name ==
        'push' && github.ref || github.run_id }}
      cancel-in-progress: ${{ github.event_name == 'pull_request' }}
  required:
    name: CI / Required
    runs-on: ubuntu-latest
    timeout-minutes: 120
    needs:
    - source
    - check_python
    - build_product
    - build_tests
    - check_rust
    - package_rust
    - validate_test_rust_integration
    - validate_test_rust_unit
    if: >-
      (always()) && (github.event_name != 'pull_request' || (github.event.action !=
      'closed' && !github.event.pull_request.draft))
    steps:
    - name: Configure Checkout Git
      run: git config --global core.longpaths true
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
    - shell: python
      run: >-
        import runpy; runpy.run_path('.github/actions/plan-impact/gate.py',
        run_name='__main__')
      env:
        RESULTS: ${{ toJSON(needs) }}
    concurrency:
      group: >-
        ci-${{ github.workflow }}-required-shared-${{ github.event_name ==
        'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
        github.run_id }}
      cancel-in-progress: ${{ github.event_name == 'pull_request' }}
  cancel_closed:
    name: Cancel / Closed Review
    if: github.event_name == 'pull_request' && github.event.action == 'closed'
    runs-on: ubuntu-latest
    timeout-minutes: 120
    strategy:
      fail-fast: false
      matrix:
        include:
        - group: >-
            ci-${{ github.workflow }}-source-shared-${{ github.event_name == 'pull_request'
            && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-check_python-shared-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-build_product-unix-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-build_product-windows-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-build_tests-unix-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-build_tests-windows-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-check_rust-unix-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-check_rust-windows-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-package_rust-unix-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-package_rust-windows-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-validate_test_rust_integration-unix-${{
            github.event_name == 'pull_request' && github.event.number || github.event_name == 'push' &&
            github.ref || github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-validate_test_rust_integration-windows-${{
            github.event_name == 'pull_request' && github.event.number || github.event_name == 'push'
            && github.ref || github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-validate_test_rust_unit-unix-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' &&
            github.ref || github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-validate_test_rust_unit-windows-${{ github.event_name
            == 'pull_request' && github.event.number || github.event_name == 'push' &&
            github.ref || github.run_id }}
        - group: >-
            ci-${{ github.workflow }}-required-shared-${{ github.event_name ==
            'pull_request' && github.event.number || github.event_name == 'push' && github.ref ||
            github.run_id }}
    concurrency:
      group: ${{ matrix.group }}
      cancel-in-progress: true
    steps:
    - shell: python
      run: pass
