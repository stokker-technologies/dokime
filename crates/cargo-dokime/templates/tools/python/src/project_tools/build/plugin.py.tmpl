"""Stage The Built Plugin Bundle Without Recompiling It"""

# === Imports === #

# Standard Library Imports
import argparse
import shutil
import subprocess
from pathlib import Path

# Third Party Imports
# Local Imports
from . import paths, run

# Type Checking Imports


# === Public Exports === #

# === Constants === #

# === Types === #

# === Classes === #

# === Public Functions === #


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("step", choices=("build", "package"))
    parser.add_argument("--profile", choices=("dev", "release"), default="dev")
    options = parser.parse_args()
    root = Path.cwd()
    output = paths.output(root, "build", options.profile)
    source = output / "plugins/{{package}}.dokime"
    if options.step == "build":
        run.rust(root, options.profile)
        metadata = output / "product/metadata.json"
        with metadata.open("w", encoding="utf-8") as written:
            subprocess.run(
                ["cargo", "metadata", "--locked", "--format-version", "1"],
                stdout=written,
                check=True,
            )
        record = output / "product/plugin.json"
        command = [
            "cargo",
            "dokime",
            "build",
            "--from-cargo-json",
            str(output / "product/compiler.json"),
            "--metadata-json",
            str(metadata),
            "--profile",
            options.profile,
            "--json",
        ]
        with record.open("w", encoding="utf-8") as written:
            subprocess.run(command, stdout=written, check=True)
        subprocess.run(
            [
                "cargo",
                "dokime",
                "package",
                "--build-json",
                str(record),
                "--output",
                str(source.parent),
            ],
            check=True,
        )
        return
    if not source.is_file():
        raise ValueError("build the matching plugin before packaging")
    destination = paths.output(root, "package", options.profile) / "rust" / source.name
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, destination)
    subprocess.run(["cargo", "dokime", "inspect", str(destination)], check=True)


# === Private Functions === #

# === Entry Point === #

if __name__ == "__main__":
    main()
