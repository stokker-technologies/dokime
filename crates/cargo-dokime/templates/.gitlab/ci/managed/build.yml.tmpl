Build / Product (unix):
  stage: Build
  tags:
  - saas-linux-medium-amd64
  timeout: 120 minutes
  needs: []
  script:
  - >-
    mise exec -- uv run --locked --project tools/python python -m
    project_tools.ci.build --profile $PROFILE --output product --task build
  - >-
    if [ "$PROFILE" = dev ]; then mise exec -- uv run --locked --project
    tools/python python -m project_tools.ci.build --profile release --output product --task
    build; fi
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "dev"
  - if: $CI_PIPELINE_SOURCE == "schedule"
  variables:
    MISE_ENABLE_TOOLS: >-
      aqua:koalaman/shellcheck,aqua:nextest-rs/nextest/cargo-nextest,github:bnjbvr/cargo-machete,github:stokker-technologies/dokime,go,go:github.com/rhysd/actionlint/cmd/actionlint,python,rust,sccache,taplo,uv
