Build / Product (windows):
  stage: Build
  tags:
  - saas-windows-medium-amd64
  timeout: 120 minutes
  needs: []
  script:
  - >-
    mise exec -- uv run --locked --project tools/python python -m
    project_tools.ci.build --profile $env:PROFILE --output product --task build
  - >-
    if ($env:PROFILE -eq 'dev') { mise exec -- uv run --locked --project
    tools/python python -m project_tools.ci.build --profile release --output product --task
    build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE } }
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "dev"
  - if: $CI_PIPELINE_SOURCE == "schedule"
  hooks:
    pre_get_sources_script:
    - git config --global core.longpaths true
  inherit:
    default:
    - interruptible
  before_script:
  - >-
    python .gitlab/actions/setup/run.py --platform windows --emit-shell |
    Invoke-Expression
  - mise trust --yes
  - mise install --yes
  variables:
    MISE_ENABLE_TOOLS: >-
      aqua:koalaman/shellcheck,aqua:nextest-rs/nextest/cargo-nextest,github:bnjbvr/cargo-machete,github:stokker-technologies/dokime,go,go:github.com/rhysd/actionlint/cmd/actionlint,python,rust,sccache,taplo,uv
