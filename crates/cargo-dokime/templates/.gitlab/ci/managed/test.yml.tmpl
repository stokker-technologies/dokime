Test / Rust / Unit (windows):
  stage: Test
  tags:
  - saas-windows-medium-amd64
  timeout: 120 minutes
  needs: []
  script:
  - mise run test:rust:unit --profile $env:PROFILE
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "dev"
  - if: $CI_PIPELINE_SOURCE == "schedule"
  artifacts:
    name: reports-$PROFILE-windows-unit-rust
    when: always
    expire_in: 7 days
    paths:
    - target/tests/$PROFILE/windows-*/unit-rust/
    - target/traces/$PROFILE/windows-*/unit-rust/
    reports:
      junit: target/tests/$PROFILE/windows-*/unit-rust/junit.xml
  hooks:
    pre_get_sources_script:
    - git config --global core.longpaths true
  inherit:
    default:
    - interruptible
  before_script:
  - >-
    python .gitlab/actions/setup/run.py --platform windows --emit-shell |
    Invoke-Expression
  - mise trust --yes
  - mise install --yes
  variables:
    MISE_ENABLE_TOOLS: >-
      go,python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,aqua:koalaman/shellcheck,go:github.com/rhysd/actionlint/cmd/actionlint,git-cliff
