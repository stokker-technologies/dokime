Test / Rust / Unit (unix):
  stage: Test
  tags:
  - saas-linux-medium-amd64
  timeout: 120 minutes
  needs: []
  script:
  - mise run test:rust:unit --profile $PROFILE
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "dev"
  - if: $CI_PIPELINE_SOURCE == "schedule"
  artifacts:
    name: reports-$PROFILE-unix-unit-rust
    when: always
    expire_in: 7 days
    paths:
    - target/tests/$PROFILE/unix-*/unit-rust/
    - target/traces/$PROFILE/unix-*/unit-rust/
    reports:
      junit: target/tests/$PROFILE/unix-*/unit-rust/junit.xml
  variables:
    MISE_ENABLE_TOOLS: >-
      go,python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,aqua:koalaman/shellcheck,go:github.com/rhysd/actionlint/cmd/actionlint,git-cliff
