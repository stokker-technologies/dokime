Release / Publish:
  stage: Release
  tags:
  - saas-linux-medium-amd64
  timeout: 120 minutes
  script:
  - python3 .gitlab/actions/review-release/run.py
  - >-
    export PROFILE="$review_profile" RELEASE_PROFILE="$review_profile"
    RELEASE_BUILD_RUN_ID="$review_run" RELEASE_BUILD_SHA="$review_sha"
    RELEASE_BUILD_VERSION="$review_version"
  - mise run release:publish
  rules:
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_TAG =~ /^v[0-9]/
  variables:
    MISE_ENABLE_TOOLS: go,python,rust,uv,git-cliff,glab
    REVIEW_RESTORE: "true"
    REVIEW_PACKAGES: "[]"
  environment:
    name: release
  id_tokens:
    PYPI_ID_TOKEN:
      aud: pypi
  needs:
  - job: Review / Release
    artifacts: true
  resource_group: release-publication
  interruptible: false
  before_script:
  - python3 .gitlab/actions/setup/run.py --platform unix
  - mise trust --yes
  - mise install --yes
  - >-
    provider_environment="$(python3 .gitlab/actions/setup/run.py --glab-version
    1.124.0 --emit-shell)" || exit $?; eval "$provider_environment"
