from collections.abc import Awaitable
from typing import final
from os import PathLike

__all__ = [
    "Client",
    "TestCycleHandle",
    "TestExecutionHandle",
    "ExecutionEvidenceStream",
    "ExecutionRequestHandle",
    "ExecutionRequestUpdates",
    "Target",
    "Backend",
    "Limits",
    "ClientError",
    "ResponseStream",
    "SuiteStream",
    "PromptStream",
    "RequestStream",
]

class ClientError(Exception):
    kind: str
    code: int | None
    details: bytes

@final
class Target:
    def __new__(
        cls, endpoint: str, *, ca_certificate_pem: str | None = None
    ) -> Target: ...
    @property
    def is_remote(self) -> bool: ...
    @property
    def endpoint(self) -> str: ...

@final
class Client:
    @staticmethod
    def connect(
        target: Target,
        *,
        token: str | None = None,
        expected_backend_id: str | None = None,
        timeout: float | None = None,
    ) -> Awaitable[Client]: ...
    @property
    def backend(self) -> Backend: ...
    def cycle(
        self, cycle_id: str, *, timeout: float | None = None
    ) -> TestCycleHandle: ...
    def register_selection(
        self, plan: bytes, key: str, *, timeout: float | None = None
    ) -> Awaitable[bytes]: ...
    def create_cycle(
        self,
        case_ids: list[str],
        metadata: bytes,
        *,
        continue_on_failure: bool = False,
        timeout: float | None = None,
    ) -> Awaitable[TestCycleHandle]: ...
    def plan_cycle(
        self,
        suite: str,
        template: str,
        parameters: bytes,
        *,
        label: str | None = None,
        timeout: float | None = None,
    ) -> Awaitable[TestCycleHandle]: ...
    def suites(self, *, timeout: float | None = None) -> Awaitable[SuiteStream]: ...
    def suite(
        self, identifier: str, *, timeout: float | None = None
    ) -> Awaitable[bytes]: ...
    def execution_request(
        self,
        request_id: str,
        *,
        cycle_id: str | None = None,
        timeout: float | None = None,
    ) -> ExecutionRequestHandle: ...
    def execution(
        self, execution_id: str, *, timeout: float | None = None
    ) -> TestExecutionHandle: ...
    def unary(
        self, method: str, request: bytes, *, timeout: float | None = None
    ) -> Awaitable[bytes]: ...
    def stream(self, method: str, request: bytes) -> Awaitable[ResponseStream]: ...
    def download_artifact(
        self,
        request: bytes,
        destination: str | PathLike[str],
        expected_size: int,
        expected_sha256: str,
    ) -> Awaitable[tuple[int, str, bytes]]: ...
    def download_report(
        self, request: bytes, destination: str | PathLike[str]
    ) -> Awaitable[tuple[int, str, bytes]]: ...
    def upload(self, method: str) -> Awaitable[RequestStream]: ...
    def verify(self, *, live: bool = True) -> Awaitable[None]: ...
    def close(self) -> Awaitable[None]: ...

@final
class Backend:
    @property
    def backend_id(self) -> str: ...
    @property
    def epoch(self) -> str: ...
    @property
    def display_name(self) -> str: ...
    @property
    def product_version(self) -> str: ...
    @property
    def api_version(self) -> str: ...
    @property
    def descriptor_sha256(self) -> str: ...
    @property
    def methods(self) -> tuple[str, ...]: ...
    @property
    def limits(self) -> Limits: ...

@final
class Limits:
    @property
    def max_request_bytes(self) -> int: ...
    @property
    def max_response_bytes(self) -> int: ...
    @property
    def max_content_bytes(self) -> int | None: ...
    @property
    def max_chunk_bytes(self) -> int | None: ...
    @property
    def max_page_items(self) -> int | None: ...
    @property
    def max_stream_buffer_items(self) -> int | None: ...

@final
class ResponseStream:
    def message(self) -> Awaitable[bytes | None]: ...
    def close(self) -> Awaitable[None]: ...

@final
class PromptStream:
    def message(self) -> Awaitable[bytes | None]: ...
    def close(self) -> Awaitable[None]: ...

@final
class SuiteStream:
    def message(self) -> Awaitable[bytes | None]: ...
    def close(self) -> Awaitable[None]: ...

@final
class RequestStream:
    def send(self, frame: bytes) -> Awaitable[None]: ...
    def finish(self) -> Awaitable[bytes]: ...
    def end_input(self) -> Awaitable[None]: ...
    def response(self) -> Awaitable[bytes]: ...
    def close(self) -> Awaitable[None]: ...

@final
class TestExecutionHandle:
    @property
    def id(self) -> str: ...
    def snapshot(self) -> Awaitable[bytes]: ...
    def checkpoint(self) -> Awaitable[bytes]: ...
    def document_at(self, checkpoint: bytes) -> Awaitable[bytes]: ...
    def context_at(self, checkpoint: bytes) -> Awaitable[bytes]: ...
    def evidence_at(self, checkpoint: bytes) -> Awaitable[bytes]: ...
    def records_at(self, checkpoint: bytes) -> Awaitable[ExecutionEvidenceStream]: ...
    def samples_at(self, checkpoint: bytes) -> Awaitable[ExecutionEvidenceStream]: ...
    def wait(
        self, *, timeout: float | None = None, poll_interval: float | None = None
    ) -> Awaitable[bytes]: ...
    def records(
        self,
        *,
        record_types: list[str] = ...,
        follow: bool = False,
        poll_interval: float | None = None,
    ) -> Awaitable[ExecutionEvidenceStream]: ...
    def samples(
        self,
        *,
        streams: list[str] = ...,
        follow: bool = False,
        page_size: int = 500,
        poll_interval: float | None = None,
    ) -> Awaitable[ExecutionEvidenceStream]: ...
    def start(
        self, request_key: str, *, mode: str = "automatic"
    ) -> Awaitable[bytes]: ...
    def command(
        self,
        request_id: str,
        command_id: str,
        action: str,
        *,
        step_id: str | None = None,
    ) -> Awaitable[bytes]: ...
    def command_receipt(self, request_id: str, command_id: str) -> Awaitable[bytes]: ...
    def pause(self) -> Awaitable[bytes]: ...
    def resume(self) -> Awaitable[bytes]: ...
    def stop(self) -> Awaitable[bytes]: ...

@final
class ExecutionEvidenceStream:
    def message(self) -> Awaitable[bytes | None]: ...
    def close(self) -> Awaitable[None]: ...

@final
class ExecutionRequestHandle:
    @property
    def id(self) -> str: ...
    def status(self) -> Awaitable[bytes]: ...
    def updates(
        self, *, poll_interval: float | None = None
    ) -> Awaitable[ExecutionRequestUpdates]: ...
    def wait(
        self, *, timeout: float | None = None, poll_interval: float | None = None
    ) -> Awaitable[bytes]: ...

@final
class ExecutionRequestUpdates:
    def message(self) -> Awaitable[bytes | None]: ...
    def close(self) -> Awaitable[None]: ...

@final
class TestCycleHandle:
    def pending_prompts(self) -> Awaitable[PromptStream]: ...
    def prompt(self, prompt_id: str) -> Awaitable[bytes]: ...
    def respond_prompt(
        self, prompt_id: str, action: str, values: bytes, accepted: bool
    ) -> Awaitable[bytes]: ...
    def samples(
        self,
        *,
        streams: list[str] = ...,
        execution_id: str | None = None,
        until: ExecutionRequestHandle | None = None,
        page_size: int = 500,
        poll_interval: float | None = None,
    ) -> Awaitable[ExecutionEvidenceStream]: ...
    def records(
        self,
        *,
        record_types: list[str] = ...,
        execution_id: str | None = None,
        until: ExecutionRequestHandle | None = None,
    ) -> Awaitable[ExecutionEvidenceStream]: ...
    @property
    def id(self) -> str: ...
    def snapshot(self) -> Awaitable[bytes]: ...
    def run(self, request_key: str) -> Awaitable[bytes]: ...
    def executions(self) -> Awaitable[list[TestExecutionHandle]]: ...
    def append(self, cases: list[str]) -> Awaitable[bytes]: ...
