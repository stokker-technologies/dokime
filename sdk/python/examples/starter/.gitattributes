# === Text === #
* text=auto eol=lf

# === Windows Scripts === #
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# === Source === #
*.py text diff=python
*.pyi text diff=python
*.toml text
*.md text diff=markdown
*.json text
*.yml text
*.yaml text
*.sh text eol=lf

# === Generated === #
uv.lock text linguist-generated=true -diff

# === Binary === #
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.whl binary
*.pyc binary
*.pyd binary
*.so binary
*.dll binary
*.dokime binary
