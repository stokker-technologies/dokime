from collections.abc import Awaitable, Sequence
from pathlib import Path
from typing import final

__all__ = [
    "Backend",
    "Client",
    "EmbeddedProvider",
    "Stream",
    "__version__",
    "contracts",
    "decode_profiles",
    "descriptors",
    "load_profile",
    "preferences",
    "profile_path",
    "read_pairing",
    "remember_endpoint",
    "validate_target",
]

__version__: str

@final
class EmbeddedProvider:
    def __new__(cls, id: str, version: str, description: str) -> EmbeddedProvider: ...

@final
class Backend:
    @staticmethod
    def start(
        port: int | None, root: Path | None, application_root: Path | None, plugins: Sequence[EmbeddedProvider]
    ) -> Awaitable[Backend]: ...
    @property
    def endpoint(self) -> str: ...
    @property
    def root(self) -> Path: ...
    def export_pairing(self, path: Path, label: str) -> None: ...
    def close(self) -> Awaitable[None]: ...

@final
class Client:
    @staticmethod
    def connect(
        endpoint: str, endpoints: list[str], settings: str, token: str | None = None, expected_id: str | None = None, ca: str | None = None
    ) -> Awaitable[Client]: ...
    @property
    def backend(self) -> str: ...
    @property
    def endpoint(self) -> str: ...
    def verify(self, live: bool) -> Awaitable[None]: ...
    def call(self, path: str, request: bytes, timeout: float) -> Awaitable[bytes]: ...
    def operations(self) -> Awaitable[str]: ...
    def stream(self, path: str, opening: bytes, timeout: float) -> Awaitable[Stream]: ...
    def close(self) -> Awaitable[None]: ...

@final
class Stream:
    def next(self) -> Awaitable[bytes | None]: ...
    def send(self, frame: bytes) -> Awaitable[None]: ...
    def finish(self) -> None: ...
    def cancel(self) -> None: ...
    def close(self) -> Awaitable[None]: ...

def contracts() -> str: ...
def descriptors(contract: str) -> bytes: ...
def preferences() -> str: ...
def validate_target(endpoint: str, ca: str | None = None) -> str: ...
def read_pairing(path: Path) -> str: ...
def profile_path(path: Path | None = None) -> Path: ...
def decode_profiles(data: bytes) -> str: ...
def load_profile(identifier: str, path: Path | None = None) -> str: ...
def remember_endpoint(profile: str, path: Path, endpoint: str) -> None: ...
