<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The Revision Feed Must Reproduce the Bytes Recorded by Consumer Locks. -->
    <Deterministic>true</Deterministic>
    <DeterministicTimestamp>2000-01-01T00:00:00Z</DeterministicTimestamp>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))=/_/harmos</PathMap>
    <PackageId>Harmos</PackageId>
    <Version>0.1.0-dev.299b7ce492e3</Version>
    <Description>Pinned Harmos SDK</Description>
    <SourceRevisionId>b15faaf202a005cf5077b3938557980f7f49fa37</SourceRevisionId>
    <RepositoryCommit>b15faaf202a005cf5077b3938557980f7f49fa37</RepositoryCommit>
    <RepositoryUrl>https://github.com/stokker-technologies/harmos</RepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="sdk/csharp/src/Harmos/**/*.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
