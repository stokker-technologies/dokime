<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- tools/prepare_harmos.py Derives Version, SourceRevisionId and RepositoryCommit From Its One Revision. -->
    <!-- Source Pinned by Revision Is Not Content-Locked: Consumers Reference This Project, Not Its Package. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/../../../sdk/csharp/tools/Harmos.packages.lock.json</NuGetLockFilePath>
    <RestorePackagesPath>$(MSBuildProjectDirectory)/../packages</RestorePackagesPath>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))=/_/harmos</PathMap>
    <PackageId>Harmos</PackageId>
    <Description>Pinned Harmos SDK</Description>
    <RepositoryUrl>https://github.com/stokker-technologies/harmos</RepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="sdk/csharp/src/Harmos/**/*.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
