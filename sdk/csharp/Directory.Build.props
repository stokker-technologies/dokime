<Project>
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '../..'))</RepoRoot>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Immutable Library Feed Revisions and Their Consumers Have Tracked Locks. -->
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.lock.json</NuGetLockFilePath>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(RepoRoot)target/cs</ArtifactsPath>
    <ArtifactsPath Condition="'$(DokimeGeneratedOnly)' == 'true'">$(RepoRoot)target/cs/generation</ArtifactsPath>
    <RestorePackagesPath>$(ArtifactsPath)/packages</RestorePackagesPath>
    <PackageOutputPath>$(ArtifactsPath)/feed</PackageOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
