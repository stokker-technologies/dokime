<configuration>
  <packageSources>
    <clear />
    <add key="Local SDK Packages" value="../../target/cs/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Local SDK Packages">
      <package pattern="Dokime" />
      <package pattern="Harmos" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
