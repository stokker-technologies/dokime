{
  "version": 6,
  "configurePresets": [
    {
      "name": "development",
      "generator": "Ninja",
      "displayName": "Development Plugin",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "development",
      "displayName": "Bundle Plugin",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "development",
      "configurePreset": "development",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 4
    }
  ]
}
