{
  "version": 6,
  "configurePresets": [
    {
      "name": "development",
      "generator": "Ninja",
      "displayName": "Development Plugin",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "development",
      "configurePreset": "development",
      "configuration": "Debug",
      "jobs": 4
    }
  ]
}
