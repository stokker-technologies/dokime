# Harmos Uses Unnamespaced Targets. Supply Them From One Dependency Graph.
if(DOKIME_HARMOS_CACHE)
  list(PREPEND CMAKE_PREFIX_PATH "${DOKIME_HARMOS_CACHE}")
endif()
find_package(Protobuf CONFIG REQUIRED)
find_package(gRPC CONFIG REQUIRED)
find_package(OpenSSL REQUIRED)
add_library(grpc++ ALIAS gRPC::grpc++)
add_library(libprotobuf ALIAS protobuf::libprotobuf)
add_library(crypto ALIAS OpenSSL::Crypto)
add_executable(protoc ALIAS protobuf::protoc)
add_executable(grpc_cpp_plugin ALIAS gRPC::grpc_cpp_plugin)
get_target_property(DOKIME_PROTOBUF_INCLUDE protobuf::libprotobuf INTERFACE_INCLUDE_DIRECTORIES)
list(GET DOKIME_PROTOBUF_INCLUDE 0 DOKIME_PROTOBUF_INCLUDE)
# Harmos Resolves Well-Known Protos Relative to Its gRPC Source Tree.
set(grpc_SOURCE_DIR "${CMAKE_CURRENT_BINARY_DIR}/harmos-dependencies")
file(MAKE_DIRECTORY "${grpc_SOURCE_DIR}/third_party/protobuf/src")
file(COPY "${DOKIME_PROTOBUF_INCLUDE}/google" DESTINATION "${grpc_SOURCE_DIR}/third_party/protobuf/src")
include(FetchContent)
FetchContent_Declare(grpc SOURCE_DIR "${grpc_SOURCE_DIR}")
FetchContent_SetPopulated(grpc SOURCE_DIR "${grpc_SOURCE_DIR}" BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}/harmos-dependencies")
if(NOT COMMAND protobuf_generate)
  include("${grpc_SOURCE_DIR}/third_party/protobuf/cmake/protobuf-generate.cmake")
endif()
