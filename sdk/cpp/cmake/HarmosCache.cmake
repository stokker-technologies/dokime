# Read an Existing Windows Harmos Build Without Reconfiguring or Writing It.
if(NOT MSVC)
  message(FATAL_ERROR "DOKIME_HARMOS_CACHE Imports a Visual Studio Debug Build; Use Package Dependencies on Other Platforms")
endif()
file(TO_CMAKE_PATH "${DOKIME_HARMOS_CACHE}" DOKIME_HARMOS_CACHE)
set(grpc_SOURCE_DIR "${DOKIME_HARMOS_CACHE}/_deps/grpc-src")
set(DOKIME_PROTOBUF_INCLUDE "${grpc_SOURCE_DIR}/third_party/protobuf/src")
file(READ "${DOKIME_HARMOS_CACHE}/harmos-cpp-conformance.vcxproj" graph)
string(REGEX MATCH "<AdditionalDependencies>([^<]+)</AdditionalDependencies>" unused "${graph}")
set(libraries "${CMAKE_MATCH_1}")
set(imported_libraries)
foreach(library IN LISTS libraries)
  if(library MATCHES "harmos_cpp|%\\(")
    continue()
  endif()
  file(TO_CMAKE_PATH "${library}" library)
  if(library MATCHES "/")
    list(APPEND imported_libraries "${DOKIME_HARMOS_CACHE}/${library}")
  else()
    list(APPEND imported_libraries "${library}")
  endif()
endforeach()
add_library(grpc++ INTERFACE IMPORTED GLOBAL)
set_target_properties(grpc++ PROPERTIES
  INTERFACE_LINK_LIBRARIES "${imported_libraries}"
  INTERFACE_INCLUDE_DIRECTORIES "${grpc_SOURCE_DIR}/include;${DOKIME_PROTOBUF_INCLUDE};${grpc_SOURCE_DIR}/third_party/abseil-cpp"
  INTERFACE_COMPILE_DEFINITIONS "NOMINMAX;WIN32_LEAN_AND_MEAN;_WIN32_WINNT=0x0600")
add_library(libprotobuf INTERFACE IMPORTED GLOBAL)
set_target_properties(libprotobuf PROPERTIES INTERFACE_LINK_LIBRARIES grpc++)
add_library(crypto INTERFACE IMPORTED GLOBAL)
set_target_properties(crypto PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${grpc_SOURCE_DIR}/third_party/boringssl-with-bazel/src/include")
add_executable(protoc IMPORTED GLOBAL)
set_target_properties(protoc PROPERTIES IMPORTED_LOCATION "${DOKIME_HARMOS_CACHE}/_deps/grpc-build/third_party/protobuf/Debug/protoc.exe")
add_executable(grpc_cpp_plugin IMPORTED GLOBAL)
set_target_properties(grpc_cpp_plugin PROPERTIES IMPORTED_LOCATION "${DOKIME_HARMOS_CACHE}/_deps/grpc-build/Debug/grpc_cpp_plugin.exe")
