@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
# A Bundled Package Carries Its Static Native Dependencies Beside the SDK and States Their Toolchain in dokime-cpp.json.
if(EXISTS "${PACKAGE_PREFIX_DIR}/dokime-cpp.json")
  if(CMAKE_VERSION VERSION_LESS 4.2)
    message(FATAL_ERROR "Configure Dokime: Install CMake 4.2 or Newer to Resolve the Bundled Static Dependencies")
  endif()
  if(MSVC AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL")
    message(FATAL_ERROR "Configure Dokime: Set CMAKE_MSVC_RUNTIME_LIBRARY to MultiThreadedDLL Before project(); "
      "the Bundled Libraries Use the Release Runtime")
  endif()
  list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")
  set(OPENSSL_ROOT_DIR "${PACKAGE_PREFIX_DIR}")
  set(OPENSSL_USE_STATIC_LIBS TRUE)
  set(ZLIB_USE_STATIC_LIBS TRUE)
endif()
find_dependency(Protobuf CONFIG)
find_dependency(gRPC CONFIG)
find_dependency(OpenSSL)
find_dependency(Harmos CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/DokimeTargets.cmake")
check_required_components(Dokime)
